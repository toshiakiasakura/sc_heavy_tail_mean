{
    "name": "sc_heavy_tail_mean",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    // Runs on the host before the container starts: a bind-mount source must already exist.
    "initializeCommand": "mkdir -p ../${localWorkspaceFolderBasename}-worktrees",
    "mounts": [
        "source=${localWorkspaceFolder},target=/workdir,type=bind,consistency=cached",
        // git worktrees live in a sibling host dir, mounted at /worktrees. Create them from inside
        // the container (git worktree add /worktrees/<name> -b <branch>): git stores absolute paths,
        // and both /workdir/.git and /worktrees/<name> resolve only in the container.
        "source=${localWorkspaceFolder}/../${localWorkspaceFolderBasename}-worktrees,target=/worktrees,type=bind,consistency=cached",
        "source=sc-heavy-tail-mean,target=/home/jovyan/.claude,type=volume",
        "source=sc-heavy-tail-mean-julia-depot,target=/home/jovyan/.julia,type=volume"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash",
                "workbench.editorAssociations": {
                    "*.ipynb": "jupyter-notebook"
                },
                "jupyter.allowLocalServer": true,
                "jupyter.jupyterServerType": "local"  // Ensures Jupyter uses local server
            },
            "extensions": [
                "julialang.language-julia",
                "0h7z.vscode-julia-format",
                "ms-toolsai.jupyter",
                "donjayamanne.vscode-jupytext",
                "REditorSupport.r",
                "RDebugger.r-debugger",
                "ms-python.python",
                "znck.grammarly",
                "janisdd.vscode-edit-csv",
                "GitHub.copilot",
                "Gruntfuggly.todo-tree",
                "ms-azuretools.vscode-docker",
                "anthropic.claude-code",
                "andrepimenta.claude-code-chat"
            ]
        }
    },
    "forwardPorts": [
        8888 // Port for Jupyter Notebook
    ],
    "postCreateCommand": "julia --project=/workdir -e 'using Pkg; Pkg.activate(\"/workdir\"); Pkg.instantiate();'",
    "remoteUser": "jovyan",
    "workspaceFolder": "/workdir",
    "shutdownAction": "stopContainer",
    "containerEnv": {
        "JULIA_NUM_THREADS": "12",
        "JULIA_DEPOT_PATH": "/home/jovyan/.julia:/opt/julia",
        "CLAUDE_CONFIG_DIR": "/workdir/.claude"
    }
}